# install.sh generates .env with unique random passwords if it does not exist.
# Keep .env private; Docker credentials apply only when initializing an empty volume.
SQLTENSOR_DB_HOST=127.0.0.1
SQLTENSOR_DB_PORT=3308
SQLTENSOR_DB_NAME=SQLT
SQLTENSOR_DB_USER=sqlt
SQLTENSOR_DB_PASSWORD=replace_with_a_unique_password
SQLTENSOR_ROOT_PASSWORD=replace_with_another_unique_password
SQLTENSOR_ADMIN_PORT=8089
