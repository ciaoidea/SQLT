#!/bin/sh
set -eu
SQLTENSOR_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$SQLTENSOR_DIR"
if [ ! -x "$SQLTENSOR_DIR/.venv/bin/python" ] || [ ! -f "$SQLTENSOR_DIR/installation-report.json" ]; then
    echo 'Run ./install.sh first to install SQLT.' >&2
    exit 1
fi
exec "$SQLTENSOR_DIR/.venv/bin/python" "$SQLTENSOR_DIR/runtime.py" --cache-mib 3584 --int8 "$@" chat
